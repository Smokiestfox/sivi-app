# Local Next.js origin. Google OAuth callback: http://localhost:3000/api/auth/google/callback
APP_URL=http://localhost:3000

# Local PostgreSQL credentials match docker-compose.yml.
DATABASE_URL=postgresql://sivi:sivi@127.0.0.1:5432/sivi

# Set real values in the local .env for login, admin access and OTP delivery.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=

SMTP_URL=
EMAIL_FROM="SiVi <no-reply@example.com>"
OTP_SECRET=

# Laya SystemOne API on the host.
LAYA_URL=http://127.0.0.1:9002
LAYA_API_KEY=
ALIBABA_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
ALIBABA_API_KEY=

STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=5242880
