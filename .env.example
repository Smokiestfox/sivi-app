# Local Next.js origin. Google OAuth callback: http://localhost:3000/api/auth/google/callback
APP_URL=http://localhost:3000

# Local PostgreSQL credentials match docker-compose.yml.
DATABASE_URL=postgresql://sivi:sivi@127.0.0.1:5432/sivi

# The local demo login and OTP flow use the database; Google and SMTP are not required.
# Demo accounts are only enabled outside production.
# Before the first local run, use `npm run db:migrate` and `npm run db:seed`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=

SMTP_URL=
EMAIL_FROM="SiVi <no-reply@example.com>"

# FastAPI base URL from the host. Add a key if the AI service requires it.
AI_MODERATION_URL=http://127.0.0.1:8100
AI_MODERATION_API_KEY=

STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=5242880
